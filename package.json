{
  "name": "ai-viva-agent",
  "version": "0.1.0",
  "description": "AI interviewer that runs a 15-minute technical viva, scores it against a rubric, and keeps an auditable record.",
  "type": "module",
  "main": "server.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "dev": "node --env-file-if-exists=.env --watch server.js",
    "test": "node --test tests/*.test.js",
    "personas": "node scripts/personas.js",
    "consistency": "node scripts/score-consistency.js",
    "loadtest": "node scripts/loadtest.js",
    "wer": "node scripts/wer.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@libsql/client": "^0.18.0",
    "express": "^4.21.2",
    "nodemailer": "^10.1.7",
    "tesseract.js": "^7.0.0",
    "unpdf": "^1.9.1"
  }
}
