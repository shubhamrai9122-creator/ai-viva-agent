# Copy to .env and fill in. `npm start` reads it automatically. Never commit .env.

# Claude (leave empty for mock mode: rule-based interviewer, heuristic scorer)
ANTHROPIC_API_KEY=
INTERVIEWER_MODEL=claude-haiku-5-5
SCORER_MODEL=claude-opus-5-5
SCORER_EFFORT=high
SCORING_CONCURRENCY=4

# Faculty dashboard passcode
FACULTY_PASSCODE=change-me

# Student email sign-in. Without SMTP_HOST, codes are printed in the server log instead.
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=you@gmail.com,
# SMTP_PASS=<a Google "app password", not your normal password>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# Optional: reject fake/disposable student emails with ValidateEasy (https://validateeasy.com)
VALIDATEEASY_API_KEY=
# Optional: only allow these email domains, comma-separated (e.g. msot.edu.in)
ALLOWED_EMAIL_DOMAINS=
# Optional: secret for signing sign-in tokens (a random one is kept in data/ otherwise)
AUTH_SECRET=

PORT=3000
